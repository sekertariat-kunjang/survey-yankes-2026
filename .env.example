# =====================================================================
# CeKReK - Environment Variables Configuration
# =====================================================================
# Salin file ini menjadi `.env` di server (misal di PythonAnywhere):
# cp .env.example .env
#
# PENTING: Jangan unggah file .env yang berisi password asli ke GitHub!
# =====================================================================

# Kunci rahasia untuk sesi login & cookie Flask (buat string acak yang aman)
SECRET_KEY=cekrek-yankes-secret-production-kediri-2026-secure-key

# Kredensial Akses Dashboard Admin CeKReK
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_kunjang_2026

# Mode Flask (Wajib 'false' untuk hosting publik PythonAnywhere)
FLASK_DEBUG=false
